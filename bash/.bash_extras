# Show at most 3 path components in \w (leading ones collapse to "...").
PROMPT_DIRTRIM=3

#
#sudo apt install bash-completion
#

# Enable git completion if available
if [ -f /usr/share/bash-completion/completions/git ]; then
    source /usr/share/bash-completion/completions/git
fi

#
# sudo apt-install git
#

if [ -f /usr/lib/git-core/git-sh-prompt ]; then
    . /usr/lib/git-core/git-sh-prompt

    GIT_PS1_SHOWDIRTYSTATE=1      # * unstaged, + staged
    GIT_PS1_SHOWSTASHSTATE=1      # $ if anything stashed
    GIT_PS1_SHOWUNTRACKEDFILES=1  # % if untracked files
    GIT_PS1_SHOWUPSTREAM=auto     # < behind, > ahead, <> diverged, = in sync

    case "$TERM" in
        *-256color|*color*|xterm*|screen*|tmux*) __git_prompt_color=yes ;;
    esac

    # user@host is only worth screen space when the shell is not local.
    if [ "$__git_prompt_color" = yes ]; then
        [ -n "$SSH_CONNECTION$SSH_TTY" ] && __host_tag='\[\033[01;32m\]\u@\h\[\033[00m\]:'
        # Expanded here, not at prompt time, so bash still sees the \[ \] markers
        # and counts the prompt width correctly.
        PS1="${debian_chroot:+($debian_chroot)}${__host_tag}"'\[\033[01;34m\]\w\[\033[01;33m\]$(__git_ps1 " (%s)")\[\033[00m\]\$ '
    else
        [ -n "$SSH_CONNECTION$SSH_TTY" ] && __host_tag='\u@\h:'
        PS1="${debian_chroot:+($debian_chroot)}${__host_tag}"'\w$(__git_ps1 " (%s)")\$ '
    fi
    unset __git_prompt_color __host_tag

    # Keep the xterm window title that ~/.bashrc sets.
    case "$TERM" in
    xterm*|rxvt*)
        PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
        ;;
    esac
fi

